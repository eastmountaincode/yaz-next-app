# Include the immutable release suffix generated by `npm run assets:r2:prepare`.
NEXT_PUBLIC_R2_ASSET_BASE_URL=https://assets.example.com/releases/yaz-release-id

# Set to false to hide the gallery helper toolbar and its editing panels.
NEXT_PUBLIC_PRODUCTION=true
SANITY_API_PROJECT_ID=
SANITY_API_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
